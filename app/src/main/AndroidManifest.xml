<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        tools:replace="android:allowBackup,android:label"
        android:name="com.tungsten.fcl.FCLApp"
        android:allowBackup="false"
        android:label="Mikael Launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldCraftLauncher">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Do not expose the upstream FCL launcher UI; Mikael Launcher owns the entry screen. -->
        <activity
            android:name="com.tungsten.fcl.activity.SplashActivity"
            tools:node="remove" />
        <activity
            android:name="com.tungsten.fcl.activity.MainActivity"
            tools:node="remove" />
        <activity-alias
            android:name="com.tungsten.fcl.ImportActivity"
            tools:node="remove" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <application
        tools:replace="android:allowBackup,android:label,android:icon,android:roundIcon"
        android:name="com.tungsten.fcl.FCLApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Mikael Launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldCraftLauncher">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HorizonNativeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="landscape">
            <meta-data
                android:name="android.app.lib_name"
                android:value="horizon_android" />
        </activity>
        <!-- Do not expose the upstream FCL launcher UI; Mikael Launcher owns the entry screen. -->
        <activity android:name="com.tungsten.fcl.activity.SplashActivity" tools:node="remove" />
        <activity android:name="com.tungsten.fcl.activity.MainActivity" tools:node="remove" />
        <activity-alias android:name="com.tungsten.fcl.ImportActivity" tools:node="remove" />
    </application>
</manifest>
